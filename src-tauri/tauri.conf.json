{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nankiv",
  "version": "0.1.0",
  "identifier": "app.nankiv.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run widget:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nankiv",
        "width": 1080,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "maxWidth": 1280,
        "maxHeight": 980,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "nankiv",
    "category": "Education",
    "shortDescription": "Placement shortlist analysis",
    "longDescription": "Check whether you and your friends are on a placement shortlist, and see what the shortlist reveals. Fully offline: files never leave your machine.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "files": {
        "PlugIns/NankivWidget.appex": "../widgets/macos/build/NankivWidget.appex"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
